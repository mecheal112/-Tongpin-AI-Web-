{
  "name": "tongpin",
  "version": "1.0.0",
  "private": true,
  "description": "同频 — AI 驱动的大学同频社交平台",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "start": "npm --workspace server run start",
    "seed": "npm --workspace server run seed",
    "reset": "npm --workspace server run reset",
    "typecheck": "npm --workspace web run typecheck",
    "test": "npm --workspace server run test"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
