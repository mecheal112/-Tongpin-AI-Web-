# 本地开发配置（由 .env.example 生成，可自行修改）
PORT=8787
NODE_ENV=development

JWT_SECRET=tongpin-local-dev-secret-please-change-in-production
JWT_EXPIRES_IN=7d

DB_PATH=data/tongpin.db

# ---------- AI 大模型接入 ----------
# 目前未配置，系统运行在内置本地语义引擎上，全部 AI 功能可用。
# 想切换成大模型驱动，取消下面其中一组的注释并填入自己的 Key 即可。
#
# 方案 A：Anthropic Claude
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# AI_MODEL=claude-sonnet-5
# AI_MODEL_FAST=claude-haiku-4-5-20251001
#
# 方案 B：任意 OpenAI 兼容服务（DeepSeek / 通义千问 / 月之暗面 / 智谱 / 本地 Ollama）
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

AI_TIMEOUT_MS=45000
AI_FALLBACK=true

SEED_DEMO=true
CORS_ORIGIN=http://localhost:5173
