# ============================================================
#  同频 Tongpin — 环境变量示例
#  复制为 .env 后按需修改。所有项都有默认值，不配置也能完整运行。
# ============================================================

# ---------- 服务 ----------
PORT=8787
NODE_ENV=development

# 用于签发登录令牌。生产环境务必改成随机长字符串。
JWT_SECRET=change-me-to-a-long-random-string
# 令牌有效期
JWT_EXPIRES_IN=7d

# 数据库文件位置（相对项目根目录或绝对路径）
DB_PATH=data/tongpin.db

# ---------- AI 大模型接入 ----------
# 可选值：anthropic | openai  (openai 兼容任意 OpenAI 协议的服务，
#          如 DeepSeek / 通义千问 / 月之暗面 / 智谱 / 本地 Ollama 等)
#
# 不配置 AI_PROVIDER 时，系统会自动使用内置的本地语义引擎，
# 全部 AI 功能依然可用（画像访谈为规则引导版，匹配与破冰为本地算法版），
# 因此评审演示不依赖外部网络。
# AI_PROVIDER=anthropic

# --- 方案 A：Anthropic Claude ---
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# AI_MODEL=claude-sonnet-5
# AI_MODEL_FAST=claude-haiku-4-5-20251001

# --- 方案 B：任意 OpenAI 兼容服务 ---
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat
# AI_MODEL_FAST=deepseek-chat

# 单次 AI 调用超时（毫秒）
AI_TIMEOUT_MS=45000
# AI 返回异常时是否自动降级到本地引擎
AI_FALLBACK=true

# ---------- 演示 / 评审 ----------
# 评审专用体验账号（seed 时创建，密码统一为 Tongpin@2026）
SEED_DEMO=true

# 允许跨域的前端地址（开发时 Vite 端口）
CORS_ORIGIN=http://localhost:5173
